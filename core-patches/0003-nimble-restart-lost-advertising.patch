+    static constexpr int32_t ADVERTISING_CHECK_MS = 1000;
+    uint8_t darkChecks = 0;
+
+    // Touge: the backstop for any lost restart. No connection and no advertising means no phone can
+    // ever reach this radio again. Two checks in a row, a second apart, so the moment between a
+    // connect stopping advertising and BLEServer counting the connection is not mistaken for it.
+    void restartAdvertisingIfDark()
+    {
+        if (!nimbleBluetooth || !bleServer || nimbleBluetooth->isDeInit || !ble_hs_synced())
+            return;
+        if (bleServer->getConnectedCount() > 0 || ble_gap_adv_active()) {
+            darkChecks = 0;
+            return;
+        }
+        if (++darkChecks < 2)
+            return;
+        darkChecks = 0;
+        LOG_WARN("BLE: no connection and not advertising; restarting advertising");
+        nimbleBluetooth->startAdvertising();
+    }
