+    // Touge: takes out the element i places behind the head, keeping the rest in order.
+    T *removeAt(int i)
+    {
+        if (i < 0 || i >= count)
+            return nullptr;
+        T *out = at(i);
+        for (int k = i; k < count - 1; k++)
+            buffer[(head + k) % MaxElements] = buffer[(head + k + 1) % MaxElements];
+        tail = (tail + MaxElements - 1) % MaxElements;
+        buffer[tail] = nullptr;
+        count--;
+        return out;
+    }
