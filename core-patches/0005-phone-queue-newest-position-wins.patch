+// Touge (core-patches/0005): a decoded position, and which lane it came in on. The 2.4 GHz
+// lane hands positions over with both hop fields zero; a LoRa one carries its hop budget.
+#ifndef ARCH_PORTDUINO
+static bool isPhonePosition(const meshtastic_MeshPacket *q)
+{
+    return q && q->which_payload_variant == meshtastic_MeshPacket_decoded_tag &&
+           q->decoded.portnum == meshtastic_PortNum_POSITION_APP;
+}
+
+static bool isFastLanePosition(const meshtastic_MeshPacket *q)
+{
+    return q->hop_start == 0 && q->hop_limit == 0;
+}
+#endif
+
+bool MeshService::replaceQueuedPosition(meshtastic_MeshPacket *p)
+{
+#ifdef ARCH_PORTDUINO
+    (void)p;
+    return false;
+#else
+    if (!isPhonePosition(p))
+        return false;
+    for (int i = 0; i < toPhoneQueue.numUsed(); i++) {
+        meshtastic_MeshPacket *&queued = toPhoneQueue.at(i);
+        // Same car, same lane: the app ranks the lanes itself, so a LoRa copy must not
+        // take the place of a fast-lane one.
+        if (!isPhonePosition(queued) || queued->from != p->from || isFastLanePosition(queued) != isFastLanePosition(p))
+            continue;
+        releaseToPool(queued);
+        queued = p;
+        tougePositionsReplaced++;
+        return true;
+    }
+    return false;
+#endif
+}
+
+bool MeshService::toPhoneQueueHasPacket(uint32_t id)
+{
+#ifdef ARCH_PORTDUINO
+    (void)id;
+    return true;
+#else
+    for (int i = 0; i < toPhoneQueue.numUsed(); i++) {
+        const meshtastic_MeshPacket *queued = toPhoneQueue.at(i);
+        if (queued && queued->id == id)
+            return true;
+    }
+    return false;
+#endif
+}
+
+bool MeshService::evictOldestQueuedPosition()
+{
+#ifdef ARCH_PORTDUINO
+    return false;
+#else
+    for (int i = 0; i < toPhoneQueue.numUsed(); i++) {
+        if (!isPhonePosition(toPhoneQueue.at(i)))
+            continue;
+        meshtastic_MeshPacket *d = toPhoneQueue.removeAt(i);
+        if (d)
+            releaseToPool(d);
+        tougePositionsEvicted++;
+        return true;
+    }
+    return false;
+#endif
+}
