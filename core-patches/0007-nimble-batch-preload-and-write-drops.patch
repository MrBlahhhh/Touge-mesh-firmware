+// Touge (core-patches/0007). Counters for the Touge fast lane's delivery stats.
+struct NimbleTougeCounters {
+    uint32_t writeDropped = 0;   // phone writes lost to a full fromPhoneQueue after the ATT write succeeded
+    uint32_t writeDuplicate = 0; // writes identical to the previous one, discarded
+    uint32_t offered = 0;        // pre-encoded batches put in front of the phone
+    uint32_t offeredRead = 0;    // and read by it
+    uint32_t offerRefused = 0;   // not taken: no link, not streaming, or one already waiting
+    uint32_t offeredLost = 0;    // still queued when the link went
+};
+void nimbleTougeCounters(NimbleTougeCounters &out);
+
+// Touge (core-patches/0007): puts an already-encoded FromRadio where the next BLE read is answered
+// from, so the read does not wait on the main task to run getFromRadio. Stock turns preloading off
+// while streaming because a preloaded packet dies with the link; this is only for position batches,
+// which the next batch supersedes anyway. Everything else keeps the stock path. False when not taken.
+// [beforeRead] is called on NimBLE's task with the bytes the moment a read takes them, so they can
+// be brought up to date in place (the batch's ages); it must not change their length.
+bool nimbleOfferToPhone(const uint8_t *fromRadio, size_t len, void (*beforeRead)(uint8_t *fromRadio, size_t len));
+
+// Touge (core-patches/0007): called on NimBLE's task with a phone write dropped because the queue
+// from the phone was full, after the ATT write had already succeeded. Must be quick and must not block.
+extern void (*nimbleWriteDroppedHook)(const uint8_t *toRadio, size_t len);
