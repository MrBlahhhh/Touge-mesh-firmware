+// Touge (core-patches/0007): see NimbleBluetooth.h. Main task only.
+bool nimbleOfferToPhone(const uint8_t *fromRadio, size_t len, void (*beforeRead)(uint8_t *fromRadio, size_t len))
+{
+#ifdef MESHTASTIC_PHONEAPI_ACCESS_CONTROL
+    // This path skips PhoneAPI's per-connection authorisation, so it stays shut where that exists.
+    (void)fromRadio;
+    (void)len;
+    tougeOfferRefused++;
+    return false;
+#else
+    if (!bluetoothPhoneAPI || !fromNumCharacteristic || fromRadio == nullptr || len == 0 || len > meshtastic_FromRadio_size ||
+        nimbleBluetoothConnHandle.load() == BLE_HS_CONN_HANDLE_NONE || !bluetoothPhoneAPI->isSendingPackets()) {
+        tougeOfferRefused++;
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> guard(bluetoothPhoneAPI->toPhoneMutex);
+        const size_t size = bluetoothPhoneAPI->toPhoneQueueSize.load();
+        // One offered batch at a time, and never the last free place: the main task's own
+        // getFromRadio answer for a waiting onRead needs somewhere to go.
+        if (tougeOfferedIndex.load() >= 0 || size + 1 >= NIMBLE_BLUETOOTH_TO_PHONE_QUEUE_SIZE) {
+            tougeOfferRefused++;
+            return false;
+        }
+        memcpy(bluetoothPhoneAPI->toPhoneQueue[size].data(), fromRadio, len);
+        tougeOfferedBeforeRead = beforeRead;
+        bluetoothPhoneAPI->toPhoneQueueByteSizes[size] = len;
+        tougeOfferedIndex = (int)size;
+        bluetoothPhoneAPI->toPhoneQueueSize++;
+    }
+    tougeOffered++;
+    // The phone reads on a fromNum notify; the value is only a counter.
+    uint8_t val[4];
+    put_le32(val, ++tougeOfferNotifyNum);
+    fromNumCharacteristic->setValue(val, sizeof(val));
+    fromNumCharacteristic->notify();
+    return true;
+#endif
+}
+
+void nimbleTougeCounters(NimbleTougeCounters &out)
+{
+    out.writeDropped = tougeWriteDropped.load();
+    out.writeDuplicate = tougeWriteDuplicate.load();
+    out.offered = tougeOffered.load();
+    out.offeredRead = tougeOfferedRead.load();
+    out.offerRefused = tougeOfferRefused.load();
+    out.offeredLost = tougeOfferedLost.load();
+}
