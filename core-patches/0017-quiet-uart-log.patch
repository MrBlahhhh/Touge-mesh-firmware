+// Touge (core-patches/0017): with the console on a UART (Heltec V3, ARDUINO_USB_CDC_ON_BOOT unset) each
+// log character is its own uart_write_bytes under the log mutex, blocking 87 us a byte once the 128 B FIFO
+// fills, so a 1 KB burst holds the loop ~80 ms against a 17 ms fast lane slot. On build 45 the V3 logged
+// 4.3 KB/s of the 11.5 KB/s at 115200, 76 % of it DEBUG. So DEBUG goes, and the per-packet INFO lines
+// test TOUGE_QUIET_UART_LOG at their call sites. The V4's console is USB CDC and keeps everything.
+// -DTOUGE_KEEP_DEBUG_LOG brings it all back for a bench session.
+#if defined(ARCH_ESP32) && !defined(MESHTASTIC_EXCLUDE_TOUGE_FAST) && !defined(TOUGE_KEEP_DEBUG_LOG) &&                       \
+    !(defined(ARDUINO_USB_CDC_ON_BOOT) && ARDUINO_USB_CDC_ON_BOOT)
+#define TOUGE_QUIET_UART_LOG 1
+#endif
+
 #ifdef USE_SEGGER
 // #undef DEBUG_PORT
 #define LOG_DEBUG(...) SEGGER_RTT_printf(0, __VA_ARGS__)
@@ -72,7 +83,13 @@
 #endif
 #else
 #if defined(DEBUG_PORT) && !defined(DEBUG_MUTE)
+#ifdef TOUGE_QUIET_UART_LOG
+// An expression like the call it replaces, never run. The arguments are still type-checked and count as
+// used, so variables kept only for a debug line do not warn, and none of them is evaluated.
+#define LOG_DEBUG(...) ((void)(0 && (DEBUG_PORT.log(MESHTASTIC_LOG_LEVEL_DEBUG, __VA_ARGS__), 0)))
+#else
 #define LOG_DEBUG(...) DEBUG_PORT.log(MESHTASTIC_LOG_LEVEL_DEBUG, __VA_ARGS__)
+#endif
 #define LOG_INFO(...) DEBUG_PORT.log(MESHTASTIC_LOG_LEVEL_INFO, __VA_ARGS__)
 #define LOG_WARN(...) DEBUG_PORT.log(MESHTASTIC_LOG_LEVEL_WARN, __VA_ARGS__)
 #define LOG_ERROR(...) DEBUG_PORT.log(MESHTASTIC_LOG_LEVEL_ERROR, __VA_ARGS__)
