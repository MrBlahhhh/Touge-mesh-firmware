+// Touge (core-patches/0014): see NotifiedWorkerThread.h.
+bool NotifiedWorkerThread::notifySooner(uint32_t delay, uint32_t v)
+{
+    if (notification != v || !enabled || tillRun(millis()) <= (long)delay)
+        return false;
+    setIntervalFromNow(delay);
+    // An interrupt that took the slot meanwhile asked to run at once: keep it so.
+    if (notification != v)
+        setInterval(0);
+    // The main loop may be asleep until the later time; wake it, as notify() does.
+    mainDelay.interrupt();
+    return true;
+}
