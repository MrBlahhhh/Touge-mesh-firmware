--- a/src/mesh/PhoneAPI.cpp
+++ b/src/mesh/PhoneAPI.cpp
@@ -1879,8 +1879,15 @@ bool PhoneAPI::handleToRadioPacket(meshtastic_MeshPacket &p)
         return false;
