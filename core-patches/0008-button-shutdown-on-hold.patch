+#if SOC_PM_SUPPORT_EXT1_WAKEUP && (defined(BUTTON_PIN) || defined(DEEP_SLEEP_WAKE_PIN))
+/**
+ * Touge (core-patches/0008): block until the wake button has been let go.
+ *
+ * ext1 wakes on a level, not an edge, so deep sleep entered with the button still down ends at once
+ * and the board boots straight back up. A button shutdown now fires while the button is held, so the
+ * radio, BLE, screen and LEDs are already off by the time this runs; only the sleep itself waits.
+ */
+static void waitForWakeButtonRelease(int pin)
+{
+#ifdef ESP32S3_WAKE_TYPE
+    const int pressedLevel = (ESP32S3_WAKE_TYPE == ESP_EXT1_WAKEUP_ANY_HIGH) ? HIGH : LOW;
+#else
+    const int pressedLevel = LOW;
+#endif
+    if (pin < 0 || digitalRead(pin) != pressedLevel)
+        return;
+
+    LOG_INFO("Wake button held; deep sleep waits for release");
+    const int releasedReadsNeeded = 5; // 50 ms of steady release rides out contact bounce
+    // A stuck button or a pin that reads low must not leave a dark board awake on battery for good.
+    const uint32_t giveUpMs = 60000;
+    const uint32_t waitStartMs = millis();
+    int releasedReads = 0;
+    while (releasedReads < releasedReadsNeeded && millis() - waitStartMs < giveUpMs) {
+        esp_task_wdt_reset(); // the 90 s app watchdog would otherwise reboot someone still holding
+        delay(10);
+        releasedReads = (digitalRead(pin) == pressedLevel) ? 0 : releasedReads + 1;
+    }
+}
+#endif
